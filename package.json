{
  "name": "urlhost",
  "version": "1.0.0",
  "private": true,
  "description": "URL hosting service.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtso/urlhost.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "env $(cat .env | grep -v '^#' | xargs) node index.js",
    "addlink": "env $(cat .env | grep -v '^#' | xargs) node scripts/add_link.js",
    "createtoken": "env $(cat .env | grep -v '^#' | xargs) node scripts/create_token.js",
    "test": "node --test"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "connect-mongo": "^5.1.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mongoose": "^8.10.1",
    "superagent": "^10.2.2"
  }
}
